{
    "config": "royale",
    "compilerOptions": {
        "debug": false,
        "targets": ["JSRoyale"],
        "source-path": [
            "src/main/resources"
        ],
        "load-config": [
            "src/main/config/compile-app-config.xml"
        ],
        "source-map": true,
        "html-template": "src/main/resources/jewel-example-index-template.html",
        "theme": "${royalelib}/themes/JewelTheme/src/main/resources/defaults.css"
    },
    "copySourcePathAssets": true,
    "additionalOptions": [
        "-js-dynamic-access-unknown-members=true",
        "-js-include-script+=src/main/assembly/third-party/highlight.js/9.12.0/highlight.min.js",
        "-js-include-css+=src/main/assembly/third-party/highlight.js/9.12.0/atom-one-dark.min.css",
        "-js-include-css+=src/main/assembly/third-party/lato/Lato.css",
        "-js-include-asset+=src/main/assembly/third-party/lato/Lato-Regular.ttf",
        "-js-include-asset+=src/main/assembly/third-party/lato/Lato-Bold.ttf",
        "-js-include-asset+=src/main/assembly/third-party/lato/Lato-Italic.ttf",
        "-js-include-asset+=src/main/assembly/third-party/lato/Lato-BoldItalic.ttf"
    ],
    "files":
    [
        "src/main/royale/App.mxml"
    ]
}
