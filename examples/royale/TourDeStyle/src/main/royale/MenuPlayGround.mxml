<s:Application xmlns:fx="http://ns.adobe.com/mxml/2009"
               xmlns:s="library://ns.apache.org/royale/style"
               xmlns:e="library://ns.apache.org/royale/style-elements">

    <s:initialView>
    <s:View>
    <s:FlexContainer vertical="true" gap="24">

        <!-- Basic vertical menu -->
        <e:Div text="Basic — A simple vertical menu with three items." />
        <s:Menu>
            <s:MenuItem><e:Span text="Item 1" /></s:MenuItem>
            <s:MenuItem><e:Span text="Item 2" /></s:MenuItem>
            <s:MenuItem><e:Span text="Item 3" /></s:MenuItem>
        </s:Menu>

        <!-- Menu with title -->
        <e:Div text="With Title — Section headers group related menu items." />
        <s:Menu>
            <s:MenuTitle><e:Span text="General" /></s:MenuTitle>
            <s:MenuItem><e:Span text="Dashboard" /></s:MenuItem>
            <s:MenuItem><e:Span text="Settings" /></s:MenuItem>
            <s:MenuTitle><e:Span text="Account" /></s:MenuTitle>
            <s:MenuItem><e:Span text="Profile" /></s:MenuItem>
            <s:MenuItem><e:Span text="Billing" /></s:MenuItem>
        </s:Menu>

        <!-- Menu with links -->
        <e:Div text="With Links — Menu items containing clickable links." />
        <s:Menu>
            <s:MenuItem><e:A text="Features" href="#" /></s:MenuItem>
            <s:MenuItem><e:A text="Pricing" href="#" /></s:MenuItem>
            <s:MenuItem><e:A text="About" href="#" /></s:MenuItem>
        </s:Menu>

        <!-- Collapsible submenu -->
        <e:Div text="Collapsible Submenu — Click 'Parent' to toggle the nested menu." />
        <s:Menu>
            <s:MenuItem><e:Span text="Item 1" /></s:MenuItem>
            <s:MenuDetails headerText="Parent" open="true">
                <s:Menu submenu="true">
                    <s:MenuItem><e:Span text="Submenu 1" /></s:MenuItem>
                    <s:MenuItem><e:Span text="Submenu 2" /></s:MenuItem>
                </s:Menu>
            </s:MenuDetails>
            <s:MenuItem><e:Span text="Item 3" /></s:MenuItem>
        </s:Menu>

    </s:FlexContainer>
    </s:View>
    </s:initialView>

</s:Application>
