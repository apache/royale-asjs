 {
    "config": "royale",
    "type": "lib",
    "compilerOptions": {
        "debug": true,
        "targets": [
            "SWF",
            "JSRoyale"
        ],
        "include-classes": [
            "IconsClasses"
        ],
        "include-sources": [
            "src/main/royale"
        ],
        "output": "target/Icons.swc"
    },
    "additionalOptions": [
        "-js-include-css+=src/main/resources/assets/material-icons/4.0.0/material-icons.css",
        "-js-include-asset+=src/main/resources/assets/material-icons/4.0.0/material-icons.woff2",

        "-js-include-css+=src/main/resources/assets/font-awesome/5.15.4/fontawesome-all.css",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-brands-400.eot",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-brands-400.svg",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-brands-400.ttf",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-brands-400.woff",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-brands-400.woff2",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-regular-400.eot",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-regular-400.svg",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-regular-400.ttf",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-regular-400.woff",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-regular-400.woff2",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-solid-900.eot",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-solid-900.svg",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-solid-900.ttf",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-solid-900.woff",
        "-js-include-asset+=src/main/resources/assets/font-awesome/5.15.4/fa-solid-900.woff2"
    ]
}
