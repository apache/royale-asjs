 {
    "config": "royale",
    "type": "lib",
    "compilerOptions": {
        "debug": true,
        "targets": [
            "SWF",
            "JSRoyale"
        ],
        "include-classes": [
            "IconsClasses"
        ],
        "include-sources": [
            "src/main/royale"
        ],
        "output": "target/Icons.swc"
    },
    "additionalOptions": [
        "-js-include-css+=src/main/assembly/css/material-design-icons/0.14.15/material-icons.css",
        "-js-include-asset+=src/main/assembly/assets/fonts/material-design-icons/0.14.15/material-icons.woff2",
        "-js-include-css+=src/main/assembly/css/fontawesome-free/5.13.0/fontawesome-all.css",
        "-js-include-asset+=src/main/assembly/assets/fonts/fontawesome-free/5.13.0/fa-brands-400.woff2",
        "-js-include-asset+=src/main/assembly/assets/fonts/fontawesome-free/5.13.0/fa-regular-400.woff2",
        "-js-include-asset+=src/main/assembly/assets/fonts/fontawesome-free/5.13.0/fa-solid-900.woff2"
    ]
}
